# GIKI Sports Complex - Local Environment Configuration Template
# Copy this file to .env and configure local values.
# The .env file is git-ignored and should NEVER contain production secrets.

# ==========================================
# Server Configuration
# ==========================================

# HTTP Server Port
# Note: Port 8080 is often occupied if GIKI Wallet backend is running.
# Use 8081 for GIKI Sports Complex to avoid port collision.
PORT=8081

# ==========================================
# PostgreSQL Database Configuration
# ==========================================

# Dedicated Host Port (bound to 127.0.0.1)
# Note: Port 5432 is occupied by native Windows PostgreSQL, and 5433 by GIKI Wallet DB.
# Port 5434 is dedicated to GIKI Sports Complex in compose.yaml.
DB_PORT=5434

# Host binding address
DB_HOST=127.0.0.1

# Database Name
DB_NAME=giki_sports_complex

# Database User (Bootstrap development user; production role separation to be configured separately)
DB_USER=giki_sports_app

# Database Password (Required: Non-empty string; DO NOT leave as placeholder in active .env)
DB_PASSWORD=your_secure_development_password_here

# SSL/TLS Mode (Options: disable, require, verify-ca, verify-full)
# WARNING: "disable" is intended strictly for local development without TLS certificates.
# Production environments must use "require" or "verify-full".
DB_SSL_MODE=disable

# ==========================================
# Connection Pool & Timeout Settings
# ==========================================

# Maximum concurrent connections in pool
DB_MAX_CONNS=10

# Minimum idle connections in pool
DB_MIN_CONNS=2

# Maximum lifetime of a pooled connection
DB_MAX_CONN_LIFETIME=1h

# Maximum idle duration before an unused connection is closed
DB_MAX_CONN_IDLE_TIME=30m

# Bounded connection attempt timeout for pool establishment and health checks
DB_CONNECT_TIMEOUT=5s

# ==========================================
# Authentication, Session Cookies & CSRF
# ==========================================

# Session cookie name (default: giki_session)
AUTH_COOKIE_NAME=giki_session

# Session cookie Secure flag (Options: false for local HTTP dev, true for HTTPS production)
# WARNING: Setting this to true over plain HTTP will prevent the browser from storing or sending the cookie.
AUTH_COOKIE_SECURE=false

# Session cookie Path attribute (default: /api)
AUTH_COOKIE_PATH=/api

# Session cookie SameSite attribute (Options: Lax, Strict, None; default: Lax)
AUTH_COOKIE_SAMESITE=Lax

# Trusted frontend origins for CSRF Origin verification on mutations (comma-separated exact origins)
# Default includes local Vite dev server and backend ports.
AUTH_TRUSTED_ORIGINS=http://localhost:5173, http://127.0.0.1:5173, http://localhost:8081, http://127.0.0.1:8081

# Login rate limiting: maximum attempts per IP within the rate window (default: 10)
AUTH_LOGIN_RATE_LIMIT=10

# Login rate limit window (default: 1m)
AUTH_LOGIN_RATE_WINDOW=1m

# Bound on concurrent CPU/memory-intensive Argon2id password verifications (default: 4)
# Returns HTTP 503 Service Unavailable with Retry-After: 1 when saturated.
AUTH_LOGIN_MAX_CONCURRENT=4

# Timeout for authentication database operations (default: 5s)
AUTH_REQUEST_TIMEOUT=5s
